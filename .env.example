# Copia este archivo a ".env" y rellena los valores.
# El servidor (server/index.js) los lee con dotenv/process.env.
# NUNCA subas el ".env" real a git — ya está en .gitignore.

# ── HackTheBox — estadísticas en tiempo real ────────────────────────────
# 1. Ve a https://app.hackthebox.com/profile/settings (o Settings → App Tokens)
# 2. Genera un "App Token" (NO tu password, NO un JWT de sesión)
# 3. Pégalo aquí:
HTB_APP_TOKEN=

# Tu ID numérico de usuario de HTB (el que aparece en la URL de tu perfil,
# https://app.hackthebox.com/users/1940973 -> 1940973). Ya viene con tu ID
# por defecto si lo dejas vacío.
HTB_USER_ID=1940973

# Puerto donde escuchará el servidor Node (opcional, por defecto 3000)
PORT=3000
